# Copy to `.env` and adjust values for local runs:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

# =============================================================================
# Generic aliases (mapped automatically by lib/env.js)
# =============================================================================
BASE_URL=
USERNAME=
PASSWORD=
API_TOKEN=
API_URL=
HEADLESS=true

# Logical environment: local | ci | staging | production
TEST_ENV=local

# Logging: debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# Playwright run options
# =============================================================================
# PW_WORKERS=1 (default) — one browser at a time; set PW_WORKERS=4 for parallel
# PW_HEADED=1 — watch tests in a visible browser
# PW_HEADLESS=1 — force headless even locally
# PW_RETRIES=2 — override retry count
PW_WORKERS=1

# Auto-cleanup of old reports/results on start (local default on; CI off)
# CLEANUP_ON_START=1
# REPORT_RETENTION_DAYS=14
# RESULTS_RETENTION_DAYS=7

# =============================================================================
# OpenAI UI analysis (screenshots + page data → ChatGPT after each spec file)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
UI_ANALYSIS=0
UI_ANALYSIS_APPLY=0
UI_ANALYSIS_STRICT=0
UI_CAPTURE_DIR=test-results/ui-capture
# UI_ANALYSIS_DIR is set per run in playwright.config.js (timestamped)

# =============================================================================
# OneDirectBuy (https://onedirectbuy.com)
# =============================================================================
ONEDIRECTBUY_BASE_URL=https://onedirectbuy.com
ONEDIRECTBUY_BUYER_EMAIL=
ONEDIRECTBUY_BUYER_PASSWORD=
ONEDIRECTBUY_ADMIN_EMAIL=
ONEDIRECTBUY_ADMIN_PASSWORD=
ONEDIRECTBUY_SELLER_EMAIL=
ONEDIRECTBUY_SELLER_PASSWORD=
ONEDIRECTBUY_SELLER_CSV=
ONEDIRECTBUY_TEST_COUPON=
# Keyword used by BuyerPurchaseJourney ATC (avoid SKUs that falsely show In stock)
ONEDIRECTBUY_ATC_KEYWORD=filter
# Stripe sandbox test card — https://stripe.com/docs/testing
ONEDIRECTBUY_STRIPE_TEST_CARD=4242424242424242
ONEDIRECTBUY_STRIPE_TEST_EXP=12 / 34
ONEDIRECTBUY_STRIPE_TEST_CVC=123
ONEDIRECTBUY_STRIPE_TEST_ZIP=34746

# Developer issues report (MD/HTML) is always on unless DEV_ISSUES_REPORT=0
# DEV_ISSUES_REPORT=1

# =============================================================================
# HTML report upload (multipart — existing uploadReporter)
# Enable only in CI or when your IP is allowed through Cloudflare.
# =============================================================================
REPORT_UPLOAD=0
REPORT_UPLOAD_URL=
REPORT_UPLOAD_AUTH_TOKEN=
REPORT_UPLOAD_CLIENT_NAME=onedirectbuy
REPORT_UPLOAD_FIELD_NAME=htmlFile
REPORT_UPLOAD_NAME=Playwright HTML Report
REPORT_UPLOAD_DESCRIPTION=
REPORT_UPLOAD_UI_ANALYSIS_NAME=UI Analysis HTML Report
REPORT_UPLOAD_UI_ANALYSIS_DESCRIPTION=
REPORT_UPLOAD_DEBUG=0
REPORT_UPLOAD_STRICT=0

# =============================================================================
# Dashboard JSON upload (scripts/upload-report.ts)
# =============================================================================
# REPORT_API_URL or API_URL — JSON dashboard endpoint
# API_TOKEN — Bearer token (also falls back to REPORT_UPLOAD_AUTH_TOKEN)
DASHBOARD_UPLOAD=0
REPORT_API_URL=
# DASHBOARD_UPLOAD_STRICT=1

# =============================================================================
# CI (set automatically in pipelines)
# =============================================================================
# CI=1
